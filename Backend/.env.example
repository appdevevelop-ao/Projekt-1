# Kopiere diese Datei nach .env (wird nicht eingecheckt) und trage deine Werte ein.
ANTHROPIC_API_KEY=
# Zugriff für die App: kommagetrennte, lange Zufallswerte (z. B. `openssl rand -hex 24`)
LF_ACCESS_TOKENS=
# Alternativ: Tokens pro Installation ausstellen (Endpunkt /v1/register)
LF_OPEN_REGISTRATION=0
LF_TOKEN_SECRET=
# Nur für lokale Tests ohne Token (erzwingt HOST=127.0.0.1)
LF_ALLOW_ANONYMOUS=0
HOST=127.0.0.1
PORT=8787
# Optional
LF_MODEL=claude-opus-5-5
LF_RATE_LIMIT_PER_HOUR=120
LF_DAILY_LIMIT=600
